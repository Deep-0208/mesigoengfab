# Canonical origin used for metadata, sitemap and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://mesigoengfab.com

# Enquiry email delivery via the Resend HTTP API (https://resend.com).
# Until all three are set, /api/enquiry/ answers 503 and the form tells the
# visitor the message was NOT sent and offers WhatsApp / phone instead.
RESEND_API_KEY=
# Inbox that receives enquiries (client to confirm the address).
ENQUIRY_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Mesigo Eng Fab <enquiry@mesigoengfab.com>".
ENQUIRY_FROM_EMAIL=
